<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Detalle Vehículo</title>
</head>
<body>
  <h1>Detalle Vehículo</h1>
  <ul>
    <li><b>ID:</b> <%= v.id %></li>
    <li><b>Marca:</b> <%= v.marca %></li>
    <li><b>Modelo:</b> <%= v.modelo %></li>
    <li><b>Precio:</b> <%= v.precio %></li>
    <li><b>Cantidad:</b> <%= v.cantidad %></li>
  </ul>
  <p>
    <a href="/vehiculos/<%= v.id %>/edit">Editar</a> |
    <a href="/vehiculos">Volver</a>
  </p>
</body>
</html>
