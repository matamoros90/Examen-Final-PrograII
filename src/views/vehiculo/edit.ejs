<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Editar Vehículo</title>
</head>
<body>
  <h1>Editar Vehículo #<%= v.id %></h1>
  <form action="/vehiculos/<%= v.id %>?_method=PUT" method="post">
    <label>Marca</label>
    <input name="marca" value="<%= v.marca %>" required>

    <label>Modelo</label>
    <input name="modelo" value="<%= v.modelo %>" required>

    <label>Precio</label>
    <input name="precio" type="number" step="0.01" value="<%= v.precio %>" required>

    <label>Cantidad</label>
    <input name="cantidad" type="number" min="0" value="<%= v.cantidad %>" required>

    <button type="submit">Actualizar</button>
    <a href="/vehiculos">Cancelar</a>
  </form>
</body>
</html>
