<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Nuevo Vehículo</title>
</head>
<body>
  <h1>Nuevo Vehículo</h1>
  <form action="/vehiculos" method="post">
    <label>Marca</label>
    <input name="marca" required>

    <label>Modelo</label>
    <input name="modelo" required>

    <label>Precio</label>
    <input name="precio" type="number" step="0.01" required>

    <label>Cantidad</label>
    <input name="cantidad" type="number" min="0" required>

    <button type="submit">Guardar</button>
    <a href="/vehiculos">Cancelar</a>
  </form>
</body>
</html>
