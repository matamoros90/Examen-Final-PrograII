<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Vehículos</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <h1>Vehículos</h1>

  <a href="/vehiculos/create">➕ Nuevo</a>

  <table border="1" cellpadding="6">
    <thead>
      <tr>
        <th>ID</th><th>Marca</th><th>Modelo</th><th>Precio</th><th>Cantidad</th><th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% if (vehiculos.length === 0) { %>
        <tr><td colspan="6">Sin registros</td></tr>
      <% } %>
      <% vehiculos.forEach(v => { %>
        <tr>
          <td><%= v.id %></td>
          <td><%= v.marca %></td>
          <td><%= v.modelo %></td>
          <td><%= v.precio %></td>
          <td><%= v.cantidad %></td>
          <td>
            <a href="/vehiculos/<%= v.id %>">Ver</a> |
            <a href="/vehiculos/<%= v.id %>/edit">Editar</a> |
            <form action="/vehiculos/<%= v.id %>?_method=DELETE" method="post" style="display:inline">
              <button type="submit" onclick="return confirm('¿Eliminar?')">Eliminar</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>
